{
  "name": "openllmrank",
  "version": "0.2.1",
  "description": "Open source CLI to track how your brand appears in answers from ChatGPT and Claude (Gemini and Perplexity planned). Generates gap analysis vs competitors and content recommendations from competitor pages. The Plausible of AI search visibility.",
  "type": "module",
  "license": "MIT",
  "author": "foodaka",
  "homepage": "https://github.com/foodaka/openllmrank#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foodaka/openllmrank.git"
  },
  "bugs": {
    "url": "https://github.com/foodaka/openllmrank/issues"
  },
  "bin": {
    "openllmrank": "./src/cli/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "start": "bun run src/cli/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli/index.ts --compile --outfile dist/openllmrank",
    "prepublishOnly": "bun test && tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "cheerio": "^1.2.0",
    "citty": "^0.1.6",
    "cli-progress": "^3.12.0",
    "openai": "^4.83.0",
    "p-limit": "^6.1.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cli-progress": "^3.11.6",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "ai-search",
    "llm-seo",
    "chatgpt-seo",
    "rank-tracking",
    "brand-visibility",
    "open-source",
    "perplexity",
    "geo",
    "ai-visibility",
    "cli"
  ]
}
