# Copy to .env.local for local dev. .env.local is gitignored.

# ---- Supabase ----
# For local dev, run `supabase start` and paste the printed values here.
# These are local-only defaults; every developer gets the same keys
# (they grant no remote access). DO NOT commit your .env.local.
# When you later run against a real Supabase project, swap these for the
# project URL + anon + service-role keys from the Supabase Dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste publishable key from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<paste secret key from `supabase status`>
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# ---- AI-assisted wizard (optional, signed-in users only) ----
# Generation uses the web server's key, independently of the worker environment.
# Leave empty to keep manual setup available without AI generation.
# Keep this server-only; never prefix the key with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Must support Chat Completions with strict JSON-schema output.
WIZARD_SUGGEST_MODEL=gpt-4o-mini

# ---- Stripe (LOCAL_STUB mode skips the real Stripe round-trip) ----
# In local dev, leave STRIPE_MODE=local_stub. The /api/checkout route
# returns a fake checkout URL that bounces straight to /checkout/success
# with a synthetic webhook event posted to /api/webhook/stripe.
#
# When you sign up for Stripe (test mode is free), set:
#   STRIPE_MODE=test
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_MODE=local_stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=local_test_secret_change_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Pricing ----
PRICE_CENTS=7900
PRODUCT_NAME=openllmrank AI-search visibility report

# ---- Email (account invites + report delivery) ----
# local_stub logs generated links instead of sending email.
POSTMARK_MODE=local_stub
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=reports@openllmrank.io
POSTMARK_FROM_NAME=openllmrank

# ---- Contact form (Telegram) ----
# /api/contact forwards the contact-modal submission to a Telegram chat
# via the Bot API. If either var is unset, the route logs the message to
# stderr and returns success (dev-friendly).
#
# To set up:
#   1. In Telegram, talk to @BotFather → /newbot → grab the token below.
#   2. Send your bot any message from your account.
#   3. curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
#      → copy result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Salt for hashing requester IPs on anonymous crawl checks (we never store
# raw IPs). Any random string; rotate to invalidate old hashes.
CRAWL_IP_SALT=change-me

# Crawl monitoring subscription price (defaults to 2900 = $29/mo).
MONITOR_PRICE_CENTS=2900

# ---- Dashboard tracking ----
# Manual re-runs a subscriber may trigger per billing period (D9).
MANUAL_RERUNS_PER_MONTH=2

# ---- Dashboard + auth ----
# Public origin of the web app. Required in production: it is the base for
# magic-link and password-setup redirects and for Stripe return URLs. Also add
# https://openllmrank.io/** to the hosted Supabase project's Redirect URLs.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
# Signs report links in emails so a forwarded email is not a permanent leak.
# Required in production. Generate with: openssl rand -hex 32
REPORT_LINK_SECRET=
# $49/mo tracking subscription (repriced 2026-09-15).
SUBSCRIPTION_PRICE_CENTS=4900
SUBSCRIPTION_PRODUCT_NAME=openllmrank tracking
# Optional Stripe Price ids (price_...). When set, Checkout references the
# catalog price instead of charging the amounts above inline, so revenue rolls
# up under one Product in the Stripe Dashboard. Created per account by
# scripts in DEPLOY.md; test-mode ids differ from live ids.
SUBSCRIPTION_PRICE_ID=
REPORT_PRICE_ID=
