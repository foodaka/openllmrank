# Copy to .env.local for local dev. .env.local is gitignored.

# ---- Supabase ----
# For local dev, run `supabase start` and paste the printed values here.
# These are local-only defaults; every developer gets the same keys
# (they grant no remote access). DO NOT commit your .env.local.
# When you later run against a real Supabase project, swap these for the
# project URL + anon + service-role keys from the Supabase Dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste publishable key from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<paste secret key from `supabase status`>
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
# Must match the worker's value. Use a long random value in production.
REPORT_LINK_SECRET=replace-with-a-long-random-secret
# Set to false only as an emergency rollback to the pre-E2 behavior.
REPORT_LINK_ENFORCE=true

# ---- Stripe (LOCAL_STUB mode skips the real Stripe round-trip) ----
# In local dev, leave STRIPE_MODE=local_stub. The /api/checkout route
# returns a fake checkout URL that bounces straight to /checkout/success
# with a synthetic webhook event posted to /api/webhook/stripe.
#
# When you sign up for Stripe (test mode is free), set:
#   STRIPE_MODE=test
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_MODE=local_stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=local_test_secret_change_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Pricing ----
PRICE_CENTS=2999
PRODUCT_NAME=openllmrank AI-search visibility report

# ---- Email (account invites + report delivery) ----
# local_stub logs generated links instead of sending email.
POSTMARK_MODE=local_stub
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=reports@openllmrank.com
POSTMARK_FROM_NAME=openllmrank

# ---- Contact form (Telegram) ----
# /api/contact forwards the contact-modal submission to a Telegram chat
# via the Bot API. If either var is unset, the route logs the message to
# stderr and returns success (dev-friendly).
#
# To set up:
#   1. In Telegram, talk to @BotFather → /newbot → grab the token below.
#   2. Send your bot any message from your account.
#   3. curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
#      → copy result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
