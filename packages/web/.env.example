# Copy to .env.local for local dev. .env.local is gitignored.

# ---- Supabase ----
# For local dev, run `supabase start` and paste the printed values here.
# These are local-only defaults; every developer gets the same keys
# (they grant no remote access). DO NOT commit your .env.local.
# When you later run against a real Supabase project, swap these for the
# project URL + anon + service-role keys from the Supabase Dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste publishable key from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<paste secret key from `supabase status`>

# ---- Stripe (LOCAL_STUB mode skips the real Stripe round-trip) ----
# In local dev, leave STRIPE_MODE=local_stub. The /api/checkout route
# returns a fake checkout URL that bounces straight to /checkout/success
# with a synthetic webhook event posted to /api/webhook/stripe.
#
# When you sign up for Stripe (test mode is free), set:
#   STRIPE_MODE=test
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_MODE=local_stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=local_test_secret_change_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Pricing ----
PRICE_CENTS=2999
PRODUCT_NAME=openllmrank AI-search visibility report
