iv></details></td><td class="rate">100%</td><td>Globex <span class="rate">0%</span></td><td><div class="gapcell"><span class="rate">0%</span><div class="bar"><span style="width:0%;background:#476f53"></span></div></div></td></tr></tbody></table>
