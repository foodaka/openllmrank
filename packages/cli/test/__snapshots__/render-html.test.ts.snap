v></details></td><td class="rate">0%</td><td>Globex <span class="rate">100%</span></td><td><div class="gapcell"><span class="rate">100%</span><div class="bar"><span style="width:100%;background:#9f3a21"></span></div></div></td></tr></tbody></table>
