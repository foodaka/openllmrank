# Copy to .env.local for local dev. .env.local is gitignored.

# ---- Postgres connection (Supabase) ----
# Use the direct DB connection string. For Supabase local dev, get this from
# `supabase status` (look for "DB URL"). For a hosted Supabase project, use
# the "Direct connection" string from Project Settings → Database (NOT the
# pooler — the worker holds a long connection).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

# ---- LLM API keys (shared across all customers) ----
# These are the only place provider keys live in production
# (per Issue 1.5 of /plan-eng-review). The web layer never sees them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=

# ---- Stripe ----
# In local_stub mode the refunder logs refunds instead of calling the Stripe
# API. Flip to test/live with a real STRIPE_SECRET_KEY when you have one.
STRIPE_MODE=local_stub
STRIPE_SECRET_KEY=

# ---- Postmark ----
# In local_stub mode the emailer writes the email body to ./outbox/ instead
# of sending. Flip to live with a real POSTMARK_SERVER_TOKEN when you have
# one.
POSTMARK_MODE=local_stub
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=report@openllmrank.io
POSTMARK_FROM_NAME=openllmrank
# Optional: address where recipient "Reply" lands. If unset, replies go to
# POSTMARK_FROM. Useful if you send from a no-reply-style address but want
# replies to hit a monitored inbox.
POSTMARK_REPLY_TO=mark@openllmrank.io

# Public web origin used in the final report email button.
REPORT_BASE_URL=http://localhost:3000

# ---- Worker tuning ----
WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_TIMEOUT_MS=1800000
WORKER_MAX_CONCURRENT=1
CLI_RUN_TIMEOUT_MS=1200000

# ---- Admin alerts (optional) ----
# Discord webhook URL for failure alerts. If unset, alerts go to stderr only.
ADMIN_ALERT_DISCORD_WEBHOOK=

# Free crawl-check loop (loop #4). Faster poll than the paid loop because the
# report page promises first signal within seconds.
CRAWL_POLL_INTERVAL_MS=1000
